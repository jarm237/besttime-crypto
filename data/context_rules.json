{
  "version": "2.0.0",
  "updated_at": "2026-06-30",
  "description": "Multi-layered context adjustment rules with source tracking for hybrid learning",
  "metadata": {
    "sources": ["manual", "learned", "hybrid"],
    "enable_learned_rules": false,
    "confidence_threshold": 0.70
  },
  "macro_context_rules": [
    {
      "id": "fomc_high_priority",
      "priority": 100,
      "layer": "macro",
      "condition": "MacroEvent.FOMC.HoursToEvent < 4 AND MacroEvent.FOMC.Importance == HIGH",
      "impact": -0.35,
      "stop_processing": true,
      "source": "manual",
      "reason": "FOMC announcement imminent - high uncertainty"
    },
    {
      "id": "fed_rate_hike",
      "priority": 95,
      "layer": "macro",
      "condition": "FedRate.Change > 0 AND FedRate.ChartPattern == ACCELERATING",
      "impact": -0.25,
      "stop_processing": false,
      "source": "manual",
      "reason": "Accelerating Fed rate hikes - negative for crypto"
    },
    {
      "id": "real_yield_spike",
      "priority": 80,
      "layer": "macro",
      "condition": "RealYield > 1.5 AND RealYield_Z > 2",
      "impact": -0.20,
      "stop_processing": false,
      "source": "manual",
      "reason": "Real yields elevated - headwind for risk assets"
    },
    {
      "id": "dxy_breakout",
      "priority": 70,
      "layer": "macro",
      "condition": "DXY > DXY_52w_high AND DXY_Trend == UP",
      "impact": -0.15,
      "stop_processing": false,
      "source": "manual",
      "reason": "USD strength at 52-week highs"
    },
    {
      "id": "vix_extreme",
      "priority": 85,
      "layer": "macro",
      "condition": "VIX > 30",
      "impact": -0.30,
      "stop_processing": false,
      "source": "manual",
      "reason": "Extreme equity volatility spillover"
    },
    {
      "id": "macro_tailwind",
      "priority": 60,
      "layer": "macro",
      "condition": "RealYield < 0 AND FedRate.Direction == PAUSE",
      "impact": 0.15,
      "stop_processing": false,
      "source": "manual",
      "reason": "Negative real rates and Fed pause - favorable for crypto"
    }
  ],
  "crypto_context_rules": [
    {
      "id": "funding_extreme_long",
      "priority": 90,
      "layer": "market",
      "condition": "Funding_Z > 2.5 AND OI_Delta > 20",
      "impact": -0.25,
      "stop_processing": false,
      "source": "manual",
      "reason": "Extreme funding rates signal over-leveraged longs"
    },
    {
      "id": "funding_extreme_short",
      "priority": 90,
      "layer": "market",
      "condition": "Funding_Z < -2.5 AND OI_Delta < -15",
      "impact": 0.20,
      "stop_processing": false,
      "source": "manual",
      "reason": "Negative funding rates signal heavy short liquidation risk"
    },
    {
      "id": "oi_compression",
      "priority": 65,
      "layer": "market",
      "condition": "OI_percentile < 20 AND OI_Trend == DOWN",
      "impact": -0.10,
      "stop_processing": false,
      "source": "manual",
      "reason": "Low open interest - thin liquidity"
    },
    {
      "id": "ratio_extreme_long",
      "priority": 75,
      "layer": "market",
      "condition": "LongShortRatio > 2.0 AND BTC_Trend == DOWN",
      "impact": -0.18,
      "stop_processing": false,
      "source": "manual",
      "reason": "Extreme long ratio with declining price - liquidation risk"
    },
    {
      "id": "ratio_extreme_short",
      "priority": 75,
      "layer": "market",
      "condition": "LongShortRatio < 0.7 AND BTC_Trend == UP",
      "impact": 0.12,
      "stop_processing": false,
      "source": "manual",
      "reason": "Extreme short ratio with rising price - squeeze potential"
    },
    {
      "id": "market_momentum",
      "priority": 50,
      "layer": "market",
      "condition": "BTC_RSI > 70 AND BTC_Trend == UP",
      "impact": -0.08,
      "stop_processing": false,
      "source": "manual",
      "reason": "Overbought conditions - mean reversion risk"
    }
  ],
  "sentiment_context_rules": [
    {
      "id": "fear_extreme",
      "priority": 70,
      "layer": "sentiment",
      "condition": "FearGreed < 25 AND Trend == DOWN",
      "impact": -0.15,
      "stop_processing": false,
      "source": "manual",
      "reason": "Extreme fear with downtrend - capitulation signal"
    },
    {
      "id": "greed_extreme",
      "priority": 70,
      "layer": "sentiment",
      "condition": "FearGreed > 75 AND Trend == UP",
      "impact": -0.12,
      "stop_processing": false,
      "source": "manual",
      "reason": "Extreme greed with uptrend - potential reversal warning"
    },
    {
      "id": "sentiment_divergence",
      "priority": 55,
      "layer": "sentiment",
      "condition": "Sentiment_Trend == UP AND Price_Trend == DOWN",
      "impact": 0.10,
      "stop_processing": false,
      "source": "manual",
      "reason": "Positive sentiment divergence - potential reversal"
    }
  ],
  "risk_context_rules": [
    {
      "id": "portfolio_heat",
      "priority": 100,
      "layer": "risk",
      "condition": "Portfolio.ExposurePercentage > 60",
      "impact": -0.30,
      "stop_processing": true,
      "source": "manual",
      "reason": "Portfolio overexposed - risk management priority"
    },
    {
      "id": "drawdown_limit",
      "priority": 95,
      "layer": "risk",
      "condition": "DrawdownPct > 15",
      "impact": -0.40,
      "stop_processing": true,
      "source": "manual",
      "reason": "Approaching drawdown limit - reduce position"
    },
    {
      "id": "volatility_cluster",
      "priority": 70,
      "layer": "risk",
      "condition": "VolatilityClustering == TRUE AND Horizon == SHORT",
      "impact": -0.20,
      "stop_processing": false,
      "source": "manual",
      "reason": "Volatility clustering detected - increase caution"
    },
    {
      "id": "correlation_spike",
      "priority": 65,
      "layer": "risk",
      "condition": "BTC_Equity_Correlation > 0.7",
      "impact": -0.15,
      "stop_processing": false,
      "source": "manual",
      "reason": "High crypto-equity correlation - systemic risk"
    }
  ],
  "time_based_rules": [
    {
      "id": "us_market_open",
      "priority": 40,
      "layer": "macro",
      "condition": "HourUTC >= 13 AND HourUTC < 21",
      "impact": -0.05,
      "stop_processing": false,
      "source": "manual",
      "reason": "US market open hours - higher correlation with equities"
    },
    {
      "id": "asia_session",
      "priority": 35,
      "layer": "macro",
      "condition": "HourUTC >= 0 AND HourUTC < 8",
      "impact": 0.02,
      "stop_processing": false,
      "source": "manual",
      "reason": "Asia trading session - typically lower volume volatility"
    },
    {
      "id": "weekend",
      "priority": 30,
      "layer": "macro",
      "condition": "DayOfWeek == SATURDAY OR DayOfWeek == SUNDAY",
      "impact": 0.05,
      "stop_processing": false,
      "source": "manual",
      "reason": "Weekend - lower institutional activity"
    }
  ],
  "global_parameters": {
    "max_cumulative_negative_impact": -0.75,
    "min_cumulative_positive_impact": -0.20,
    "default_confidence": 0.70,
    "enable_expression_parser": true,
    "enable_stop_processing": true,
    "enable_learned_rules": false,
    "learned_rule_confidence_threshold": 0.75
  }
}
