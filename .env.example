META_REJECT_THRESHOLD=0.45

# RL Exit safety: default shadow; only an approved promotion may use active.
RL_EXIT_MODE=shadow
RL_EXIT_ALLOW_LIVE_ACTION=false
RL_EXIT_MAX_INFERENCE_FAILURES=3
RL_EXIT_MAX_LATENCY_MS=150
DEPLOYMENT_ID=

MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional: comma-separated chat IDs allowed to send commands. TELEGRAM_CHAT_ID
# is always allowed when configured.
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini API Key (Lay tai https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auto-Trading (CCXT) ──────────────────────────────────────────────────────
# CANH BAO: Tat ca mac dinh la DRY_RUN=true. Khong doi thanh false khi chua kiem tra ky.

# Binance Testnet API Keys (Lay tai: https://testnet.binance.vision)
AUTO_TRADE_BINANCE_API_KEY=your_testnet_api_key
AUTO_TRADE_BINANCE_API_SECRET=your_testnet_api_secret
AUTO_TRADE_BINANCE_TESTNET=true        # true=testnet, false=mainnet (NGUY HIEM)

# Mode: true=chi log va notify, khong dat lenh that
AUTO_TRADE_DRY_RUN=true

# Nguong tin hieu de kich hoat auto-trade
AUTO_TRADE_META_THRESHOLD=0.85         # Meta confidence >= 85%
AUTO_TRADE_SCORE_THRESHOLD=75          # Signal score >= 75

# Quan ly von (500 USDT account, risk 2%/lenh)
AUTO_TRADE_ACCOUNT_USDT=500            # Uoc tinh tong tai khoan
AUTO_TRADE_RISK_PCT=2.0                # % Risk moi lenh (2% = 10 USDT risk)
AUTO_TRADE_MAX_TRADE_USDT=100          # Cap toi da moi lenh
AUTO_TRADE_MIN_TRADE_USDT=10           # Toi thieu (Binance min notional)
AUTO_TRADE_POSITION_SIZING_METHOD=hybrid # kelly | std_dev | hybrid


# Gioi han hoat dong
AUTO_TRADE_MAX_DAILY=5                 # So lenh toi da moi ngay
AUTO_TRADE_CIRCUIT_BREAKER_N=5         # Dung sau N lenh thua lien tiep (24h)
AUTO_TRADE_COINS=                      # De trong=tat ca coins, hoac: BTC,ETH

# Enable Auto-Trading on higher timeframes (MTF). Default disabled.
# Set to true to allow trading on TFs from mtf_analysis (1h/4h/1d).
AUTO_TRADE_MTF_ENABLED=false
# Comma-separated list of TFs to consider, evaluated in order. Examples: "1h,4h" or "4h,1d"
AUTO_TRADE_MTF_TFS=1h

# ── Sprint 3: Meta Signal Filter ─────────────────────────────────────────────
# Chi bat sau khi calibration_report.py xac nhan model da calibrated tot.
# Khi meta_prob < nguong, score bi tru 20 diem (penalty, khong reject hoan toan).
# De 0 (hoac bo trong) de DISABLE. Bat: META_REJECT_THRESHOLD=0.45
META_REJECT_THRESHOLD=0
# Phase 7 Alternative Data Free-First Configuration
FREE_FIRST_MODE=true

ENABLE_BINANCE=true
ENABLE_DEFILLAMA=true
ENABLE_ALTERNATIVE_ME=true
ENABLE_BLOCKCHAIN_COM=true
ENABLE_BLOCKCHAIR=true
ENABLE_YAHOO_FINANCE=true
ENABLE_STOOQ=true
ENABLE_FRED=true
ENABLE_DERIBIT=true
ENABLE_GOOGLE_TRENDS=true
ENABLE_REDDIT=true
ENABLE_ETF=true

# Optional paid providers — disabled by default
ENABLE_GLASSNODE=false
GLASSNODE_API_KEY=

ENABLE_WHALE_ALERT=false
WHALE_ALERT_API_KEY=

ENABLE_CRYPTOQUANT=false
CRYPTOQUANT_API_KEY=

# ==================================================
# Parse.bot Farside ETF Flows
# ==================================================
# Lay PARSEBOT_BASE_URL tu dashboard/subscription cua Parse.bot.
# Khong hardcode https://api.parsebot.com neu endpoint nay khong ton tai.

PARSEBOT_ENABLED=false
PARSEBOT_API_KEY=
PARSEBOT_BASE_URL=

PARSEBOT_TIMEOUT_SECONDS=20
PARSEBOT_MAX_RETRIES=2
PARSEBOT_RETRY_DELAY_SECONDS=5
PARSEBOT_CACHE_TTL_HOURS=20

ETF_FLOW_PROVIDER=parsebot_farside
ETF_FLOW_TIMEZONE=Asia/Ho_Chi_Minh

# ==================================================
# Parse.bot Endpoint Names
# ==================================================

PARSEBOT_ENDPOINT_BTC_RECENT=get_bitcoin_etf_flows_recent
PARSEBOT_ENDPOINT_BTC_ALL=get_bitcoin_etf_flows_all

PARSEBOT_ENDPOINT_ETH_RECENT=get_ethereum_etf_flows_recent
PARSEBOT_ENDPOINT_ETH_ALL=get_ethereum_etf_flows_all

PARSEBOT_ENDPOINT_SOL_FLOWS=get_solana_etf_flows

PARSEBOT_ENDPOINT_FUND_INFO=get_fund_info

# ==================================================
# Parse.bot Scheduling (cron, tz=Asia/Ho_Chi_Minh)
# ==================================================
# recent: Thu 2-6, 06:00-09:00 VN (sau phien My dong)
# all:    Thu 2-6, 09:30 VN (backfill lich su + verify ngay moi nhat)
# fund:   Hang ngay, 10:00 VN

PARSEBOT_ETF_RECENT_CRON=0 6,7,8,9 * * 2-6
PARSEBOT_ETF_ALL_CRON=30 9 * * 2-6
PARSEBOT_FUND_INFO_CRON=0 10 * * *

# ==================================================
# Supported ETF Symbols
# ==================================================
# BTC: recent + all
# ETH: recent + all
# SOL: chi recent (get_solana_etf_flows)
# Cac coin khac (BNB, XRP, ADA...) khong co ETF flow endpoint that

SUPPORTED_ETF_FLOW_SYMBOLS=BTC,ETH,SOL
SUPPORTED_ETF_RECENT_SYMBOLS=BTC,ETH,SOL
SUPPORTED_ETF_ALL_SYMBOLS=BTC,ETH

# ==================================================
# Feature Flags — tung endpoint
# ==================================================

ENABLE_PARSEBOT_BTC_RECENT=true
ENABLE_PARSEBOT_BTC_ALL=true
ENABLE_PARSEBOT_ETH_RECENT=true
ENABLE_PARSEBOT_ETH_ALL=true
ENABLE_PARSEBOT_SOL_FLOWS=true
ENABLE_PARSEBOT_FUND_INFO=true

# ==================================================
# Fallback / Cache / Data Quality
# ==================================================
# ETF_FLOW_ALLOW_DEFAULT_FAKE_DATA=false: Quan trong nhat.
# Khi API fail, phai bao cao la failed/stale/missing, khong dung 0.0 gia.

ETF_FLOW_USE_CACHE_ON_FAIL=true
ETF_FLOW_MAX_STALE_HOURS=36
ETF_FLOW_DISABLE_WEIGHT_ON_FAIL=true
ETF_FLOW_DISABLE_WEIGHT_ON_STALE=true
ETF_FLOW_ALLOW_DEFAULT_FAKE_DATA=false
