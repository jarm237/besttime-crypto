META_REJECT_THRESHOLD=0.45

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Gemini API Key (Lay tai https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auto-Trading (CCXT) ──────────────────────────────────────────────────────
# CANH BAO: Tat ca mac dinh la DRY_RUN=true. Khong doi thanh false khi chua kiem tra ky.

# Binance Testnet API Keys (Lay tai: https://testnet.binance.vision)
AUTO_TRADE_BINANCE_API_KEY=your_testnet_api_key
AUTO_TRADE_BINANCE_API_SECRET=your_testnet_api_secret
AUTO_TRADE_BINANCE_TESTNET=true        # true=testnet, false=mainnet (NGUY HIEM)

# Mode: true=chi log va notify, khong dat lenh that
AUTO_TRADE_DRY_RUN=true

# Nguong tin hieu de kich hoat auto-trade
AUTO_TRADE_META_THRESHOLD=0.85         # Meta confidence >= 85%
AUTO_TRADE_SCORE_THRESHOLD=75          # Signal score >= 75

# Quan ly von (500 USDT account, risk 2%/lenh)
AUTO_TRADE_ACCOUNT_USDT=500            # Uoc tinh tong tai khoan
AUTO_TRADE_RISK_PCT=2.0                # % Risk moi lenh (2% = 10 USDT risk)
AUTO_TRADE_MAX_TRADE_USDT=100          # Cap toi da moi lenh
AUTO_TRADE_MIN_TRADE_USDT=10           # Toi thieu (Binance min notional)

# Gioi han hoat dong
AUTO_TRADE_MAX_DAILY=5                 # So lenh toi da moi ngay
AUTO_TRADE_CIRCUIT_BREAKER_N=5         # Dung sau N lenh thua lien tiep (24h)
AUTO_TRADE_COINS=                      # De trong=tat ca coins, hoac: BTC,ETH

# ── Sprint 3: Meta Signal Filter ─────────────────────────────────────────────
# Chi bat sau khi calibration_report.py xac nhan model da calibrated tot.
# Khi meta_prob < nguong, score bi tru 20 diem (penalty, khong reject hoan toan).
# De 0 (hoac bo trong) de DISABLE. Bat: META_REJECT_THRESHOLD=0.45
META_REJECT_THRESHOLD=0
